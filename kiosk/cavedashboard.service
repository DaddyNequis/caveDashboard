[Unit]
Description=Cave Dashboard kiosk
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
User=__USER__
WorkingDirectory=/opt/cavedashboard
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=CAVE_PORT=80
EnvironmentFile=-/etc/default/cavedashboard
# Lets the server listen on port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/xinit /opt/cavedashboard/kiosk/session.sh -- :0 vt1 -nocursor -keeptty -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
